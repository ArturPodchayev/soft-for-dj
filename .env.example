# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin) — shared password, no per-user accounts for Stage 1
ADMIN_PASSWORD=
# Random secret used to sign the admin session cookie (any long random string)
ADMIN_SESSION_SECRET=

# Optional: used by lib/deepseek.ts to normalize messy guest-typed titles
# before searching iTunes for cover art/duration. Falls back to the raw
# "Artist - Title" string when unset — never blocks approval.
DEEPSEEK_API_KEY=

# Module 4 (autosearch + autodownload, src/lib/download/) — Google Drive
# service account used to upload confirmed tracks.
#
# GOOGLE_SERVICE_ACCOUNT_JSON: the service account key file's full JSON
# content, base64-encoded onto a single line (most env var UIs, Vercel's
# dashboard included, handle one base64 line far more reliably than
# embedded newlines/quotes). Encode it with:
#   macOS/Linux: base64 -w0 service-account.json
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# The service account's email (client_email in that JSON) must also be
# shared on the target Drive folder, same as sharing it with a person.
GOOGLE_SERVICE_ACCOUNT_JSON=

# GOOGLE_DRIVE_FOLDER_ID: the destination folder's ID (the segment after
# /folders/ in its Google Drive URL).
GOOGLE_DRIVE_FOLDER_ID=
