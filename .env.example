# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin) — shared password, no per-user accounts for Stage 1
ADMIN_PASSWORD=
# Random secret used to sign the admin session cookie (any long random string)
ADMIN_SESSION_SECRET=

# Optional: used by lib/deepseek.ts to normalize messy guest-typed titles
# before searching iTunes for cover art/duration. Falls back to the raw
# "Artist - Title" string when unset — never blocks approval.
DEEPSEEK_API_KEY=
